rules_version = '2';

// Reglas de seguridad de la base de datos (Firestore).
//
// IMPORTANTE: este archivo NO hace nada por sí solo estando aquí. Hay que
// copiarlo/publicarlo en la consola de Firebase:
//   Firebase Console > Firestore Database > pestaña "Reglas" > Publicar
//
// Sin reglas correctas, CUALQUIER persona en internet podría leer o borrar
// los movimientos de todos los usuarios, aunque la app se vea bien.
//
// ---------------------------------------------------------------------------
// LO QUE PASÓ EL 21/08/2026, Y POR QUÉ HAY UNA PRUEBA VIGILANDO ESTO
// ---------------------------------------------------------------------------
// La copia de seguridad llevaba semanas fallando en silencio. El motivo estaba
// aquí: la lista `hasOnly` de abajo tenía ONCE campos y la app ya mandaba
// DIECISÉIS. `hasOnly` significa "el documento solo puede tener estas claves",
// así que al llegar `pagosProgramados` —o el calendario, o las categorías
// propias— Firestore rechazaba **la escritura entera**, no el campo de más.
//
// Cada función nueva que guardaba algo rompía el respaldo, y no se notaba
// porque la subida se tragaba el error. Se veía como "todo bien" hasta que
// alguien entraba en otro celular.
//
// La lista de abajo tiene que coincidir EXACTAMENTE con `CloudData` en
// utils/cloudSync.ts. Ya no depende de acordarse: `verificar-reglas-nube`
// compara las dos y falla si se separan. Si esa prueba se queja, hay que
// publicar este archivo otra vez en la consola.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada persona guarda todo en un solo documento: users/{su-id}
    match /users/{userId} {

      // Solo puedes leer/borrar TU propio documento, y solo si iniciaste
      // sesión Y confirmaste tu correo.
      allow read, delete: if request.auth != null
                       && request.auth.uid == userId
                       && request.auth.token.email_verified == true;

      allow create, update: if request.auth != null
                         && request.auth.uid == userId
                         && request.auth.token.email_verified == true
                         && request.resource.data.keys().hasOnly([
                              'hasOnboarded', 'userName', 'userPhoto', 'userCurrency',
                              'userLanguage', 'budgets', 'categoryBudgets', 'transactions', 'deletedTransactionIds',
                              'goals', 'pagosProgramados', 'isPremium', 'premiumTrialStartedAt', 'merchantLearned',
                              'categoryOverrides', 'categoriasPropias', 'carryoverCleared',
                              'iconosFavoritos'
                            ])
                         // Los que van siempre.
                         && request.resource.data.hasOnboarded is bool
                         && request.resource.data.userName is string
                         && (request.resource.data.userPhoto is string || request.resource.data.userPhoto == null)
                         && request.resource.data.userCurrency is string
                         && request.resource.data.userLanguage is string
                         && request.resource.data.budgets is map
                         && request.resource.data.categoryBudgets is map
                         && request.resource.data.transactions is list
                         && (!('deletedTransactionIds' in request.resource.data)
                              || request.resource.data.deletedTransactionIds is list)
                         && request.resource.data.goals is list
                         && request.resource.data.isPremium is bool
                         // Premium nunca lo concede el celular. Una cuenta nueva empieza
                         // sin Premium y, después, el cliente solo puede conservar el valor
                         // que ya exista. La consola/servidor administrativo sigue pudiendo
                         // activarlo para testers y, más adelante, tras validar una compra.
                         && (
                              (!exists(/databases/$(database)/documents/users/$(userId))
                                && request.resource.data.isPremium == false)
                              || (exists(/databases/$(database)/documents/users/$(userId))
                                && request.resource.data.isPremium == resource.data.isPremium)
                            )
                         && (!('premiumTrialStartedAt' in request.resource.data)
                              || request.resource.data.premiumTrialStartedAt is number)
                         && (!exists(/databases/$(database)/documents/users/$(userId))
                              || !('premiumTrialStartedAt' in resource.data)
                              || (('premiumTrialStartedAt' in request.resource.data)
                                && request.resource.data.premiumTrialStartedAt
                                  == resource.data.premiumTrialStartedAt))
                         // Y LOS OPCIONALES, COMPROBADOS SOLO SI VIENEN.
                         //
                         // Son opcionales de verdad: una cuenta creada antes de esa función no
                         // los tiene, y JSON.stringify quita las claves vacías antes de subir.
                         // Exigirlos a secas rechazaría a esas cuentas — el mismo fallo de
                         // arriba con otro disfraz.
                         && (!('merchantLearned' in request.resource.data) || request.resource.data.merchantLearned is map)
                         && (!('pagosProgramados' in request.resource.data) || request.resource.data.pagosProgramados is list)
                         && (!('categoryOverrides' in request.resource.data) || request.resource.data.categoryOverrides is map)
                         && (!('categoriasPropias' in request.resource.data) || request.resource.data.categoriasPropias is list)
                         && (!('carryoverCleared' in request.resource.data) || request.resource.data.carryoverCleared is list)
                         && (!('iconosFavoritos' in request.resource.data) || request.resource.data.iconosFavoritos is list);
    }

    // EL MODO NEGOCIO, QUE VIVE EN SU PROPIO DOCUMENTO. **Faltaba (21/08/2026).**
    //
    // Sus ventas, productos y precios no caben en el documento de arriba —tope de 1 MB— así
    // que utils/cloudNegocio los guarda en "negocios/{uid}", aparte. Pero aquí no había
    // ninguna regla para ese sitio, así que caía en el "todo cerrado" de más abajo: Firestore
    // rechazaba cada intento y la copia del negocio no se hizo NUNCA.
    //
    // Sin lista de campos a propósito: es lo que acaba de costar semanas de respaldo. Las tres
    // condiciones que de verdad protegen —es tuyo, hay sesión y el correo está confirmado— se
    // quedan igual que arriba.
    match /negocios/{userId} {
      allow read, write: if request.auth != null
                      && request.auth.uid == userId
                      && request.auth.token.email_verified == true;
    }

    // Tarjetas de crédito: documento separado para no acercar la copia
    // principal al límite de 1 MB. Solo la cuenta dueña puede leerlo.
    match /creditCards/{userId} {
      allow read, delete: if request.auth != null
                       && request.auth.uid == userId
                       && request.auth.token.email_verified == true;
      allow create, update: if request.auth != null
                         && request.auth.uid == userId
                         && request.auth.token.email_verified == true
                         && request.resource.data.keys().hasOnly(['backup'])
                         && request.resource.data.backup is map;
    }

    // Todo lo demás queda cerrado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
