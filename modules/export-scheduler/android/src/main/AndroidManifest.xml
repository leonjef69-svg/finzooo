<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Para volver a poner el despertador despues de reiniciar el celular. Los
    despertadores de Android NO sobreviven a un reinicio: sin esto, apagar y
    encender el telefono deja la exportacion automatica muerta en silencio
    hasta que alguien vuelva a entrar a la pantalla de ajustes.
  -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <!-- El trabajo privado conserva su nombre para las alarmas existentes.
         Conocer la accion no autentica al remitente: otra app no puede entrar. -->
    <receiver
      android:name="com.finzo.exportscheduler.FinzoExportReceiver"
      android:exported="false" />

    <!-- Entrada separada del arranque protegido del sistema. Nunca exporta. -->
    <receiver
      android:name="com.finzo.exportscheduler.FinzoBootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>

    <!--
      El servicio que despierta a Fino lo justo para armar el reporte y
      subirlo, sin abrirla ni ensenar nada.
    -->
    <service
      android:name="com.finzo.exportscheduler.FinzoExportService"
      android:exported="false" />
  </application>
</manifest>
