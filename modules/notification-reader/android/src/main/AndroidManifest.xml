<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <application>
    <!--
      El servicio que despierta a Fino lo justo para registrar el movimiento,
      sin abrirla. No se exporta: solo lo arranca el propio Fino, desde el
      servicio de notificaciones de arriba.
    -->
    <service
      android:name="com.finzo.notificationreader.FinzoCaptureService"
      android:exported="false" />

    <!--
      Servicio que el sistema Android usa para entregarnos las notificaciones.

      Sobre "exported=true": es lo que documenta Android para este tipo de
      servicio, y hace falta para que Fino aparezca en la lista de "Acceso a
      notificaciones" de los ajustes del sistema. No abre ningún agujero: la
      línea "android:permission" de abajo exige BIND_NOTIFICATION_LISTENER_SERVICE,
      un permiso que SOLO tiene el sistema operativo y que ninguna otra app
      puede pedir. Es decir, exportado pero con la puerta cerrada con llave.
    -->
    <service
      android:name="com.finzo.notificationreader.FinzoNotificationListener"
      android:exported="true"
      android:label="Fino"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
    <receiver
      android:name="com.finzo.notificationreader.FinzoRebindReceiver"
      android:enabled="true"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
