<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del widget redondo: un círculo violeta relleno.

  Al ser un círculo sobre el fondo de pantalla, parece un botón flotante
  aunque técnicamente esté colocado en la cuadrícula como cualquier ícono.
  Esa es toda la diferencia con una burbuja de verdad: se mueve donde uno
  lo ponga y cambia de página, pero no se mete encima de otras apps — que
  es justo lo que obligaba a pedir el permiso vigilado por Google.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
  <solid android:color="#8B5CF6" />
</shape>
