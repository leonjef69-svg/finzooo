{
  "expo": {
    "name": "Finzo",
    "slug": "finzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finzo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "package": "com.finzo.app",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "application/pdf" }]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT"],
          "data": [
            { "scheme": "content", "mimeType": "application/pdf" },
            { "scheme": "file", "mimeType": "application/pdf" }
          ]
        }
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-speech-recognition",
      [
        "expo-image-picker",
        {
          "photosPermission": "Finzo necesita tus fotos solo para leer la boleta que elijas. La imagen no sale de tu celular.",
          "cameraPermission": "Finzo usa la cámara para escanear boletas. La foto se lee dentro de tu celular y no se envía a ningún servidor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0c230a1-8bf6-4b65-a12d-24054597e161"
      }
    },
    "owner": "asdsadasd23213",
    "updates": {
      "url": "https://u.expo.dev/f0c230a1-8bf6-4b65-a12d-24054597e161"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
